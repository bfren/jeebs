
<p>Welcome, @User.Identity?.Name (@User.GetUserId())</p>

<h3>Actions</h3>
<form asp-action="SignOut" method="post">
	<button type="submit">Sign Out</button> |
	<a asp-action="Allow">Allow</a> |
	<a asp-action="Deny">Deny</a>
</form>

<h4>Claims</h4>
@foreach (var item in User.Claims)
{
	<p>@item.Subject - @item.Type - @item.Value</p>
}
