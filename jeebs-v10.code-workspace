{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"editor.insertSpaces": false,
		"editor.renderWhitespace": "all",
		"files.eol": "\r\n",
		"files.trimTrailingWhitespace": true,
		"files.exclude": {
			"**/*.csproj.user": true,
			"**/.DS_Store": true,
			"**/.git": true,
			"**/bin/**": true,
			"**/obj/**": true,
			".vs/**": true,
			".vscode/**": true,
			"docs/**": true,
		},
		"dotnet.defaultSolution": "Jeebs (v10).sln",
        "emeraldwalk.runonsave": {
            "commands": [
                {
                    "match": "\\.(cs)$",
                    "cmd": "dotnet-fast format \"${fileDirname}\" --no-restore --include \"${relativeFile}\"",
                    //"cmd": "echo \"File ${file} in ${fileDirname}\"",
                    "showElapsed": true,
                    "isAsync": true
                }
            ]
        }
	}
}
